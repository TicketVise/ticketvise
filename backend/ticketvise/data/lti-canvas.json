{
  "title": "TicketVise",
  "description": "TicketVise LTI 1.3 Tool",
  "oidc_initiation_url": "http://ivan.ticketvise.com/lti/login",
  "target_link_uri": "http://ivan.ticketvise.com/lti/launch",
  "scopes": [
    "https://purl.imsglobal.org/spec/lti-ags/scope/lineitem.readonly",
    "https://purl.imsglobal.org/spec/lti-nrps/scope/contextmembership.readonly"
  ],
  "extensions": [
    {
      "privacy_level": "public",
      "platform": "instructure.com",
      "settings": {
        "text": "TicketVise",
        "placements": [
          {
            "text": "TicketVise",
            "enabled": true,
            "placement": "course_navigation",
            "default": "disabled",
            "message_type": "LtiResourceLinkRequest",
            "target_link_uri": "http://ivan.ticketvise.com/lti/launch",
            "canvas_icon_class": "icon-lti"
          }
        ]
      }
    }
  ],
  "public_jwk_url": "http://ivan.ticketvise.com/lti/jwks",
  "custom_fields": {
    "email": "$Person.email.primary",
    "canvas_user_id": "$Canvas.user.loginId",
    "course_id": "$Canvas.course.id",
    "section_ids": "$Canvas.course.sectionIds",
    "course_start_at": "$Canvas.course.startAt",
    "course_end_at": "$Canvas.course.endAt"
  }
}
